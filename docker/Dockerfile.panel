FROM golang:1.22-alpine AS builder
WORKDIR /app
COPY go.mod ./
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o /telegate-panel ./cmd/panel
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o /telegate-agent ./cmd/agent

FROM alpine:latest
RUN apk add --no-cache ca-certificates curl tzdata
WORKDIR /root/
COPY --from=builder /telegate-panel .
COPY --from=builder /telegate-agent .
EXPOSE 8080
CMD ["./telegate-panel"]
